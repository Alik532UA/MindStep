// Realtime Database тримає рівно одне: присутність гравців у кімнаті —
// `/status/{roomId}/{playerId}` (див. `src/lib/services/presenceService.ts`).
//
// ЧОМУ ВОНА ТУТ, А НЕ У FIRESTORE. Через `onDisconnect`: вбудований механізм,
// який виконує СЕРВЕР, коли клієнт зник — включно з випадком, коли вкладку
// закрили або звʼязок обірвався в метро. У Firestore такого немає, і офіційна
// порада — підключити поруч RTDB (CLOUD-DATABASE-v8 § 5.1).
//
// ІСТОРІЯ ДІРКИ. Доти тут стояло `.read: true` / `.write: true` у КОРЕНІ:
// будь-хто з публічним конфігом Firebase (а він за побудовою лежить у бандлі)
// міг прочитати всю базу одним запитом і стерти її одним записом. Потім гілку
// звузили до `status`, але запис лишався БЕЗ АВТОРИЗАЦІЇ — тобто будь-хто
// оголошував будь-кого офлайном, і суперник бачив «гравець вийшов» посеред
// партії.
//
// ЧОМУ ТЕПЕР АВТОРИЗАЦІЯ ВИМАГАЄТЬСЯ. Стара причина не вимагати її була
// записана так: «`onDisconnect` реєструється до того, як завершиться анонімний
// вхід». Це вже не так: присутність запускає `OnlinePresenceManager` після
// входу в кімнату, а `roomService.joinRoom` сам чекає на анонімний вхід
// (`playerId = currentUser.uid`). Тобто до моменту реєстрації `onDisconnect`
// сесія вже є.
//
// ЯКЩО ПРИСУТНІСТЬ РАПТОМ ЗЛАМАЛАСЯ — дивитись саме сюди: симптом буде
// «гравець назавжди офлайн» або тиша в `.info/connected`. Запис у
// PROJECT-CONTEXT.md про це стоїть.
{
  "rules": {
    "status": {
      "$roomId": {
        ".read": "auth != null",
        "$playerId": {
          // Кожен пише лише про себе. `playerId` у цьому проєкті — це `auth.uid`
          // (`roomService.joinRoom`), тому звуження нічого в застосунку не
          // відбирає.
          ".write": "auth != null && $playerId === auth.uid",
          // Формат запису задає presenceService: { state, last_changed }.
          // Видалення (null) під `.validate` не потрапляє — це навмисно.
          ".validate": "newData.hasChildren(['state'])",
          "state": {
            ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
          },
          "last_changed": {
            // Час ставить сервер: `serverTimestamp()` розкривається до валідації,
            // тож вікно навколо `now` відкидає підроблене число.
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 5000"
          }
        }
      }
    }
  }
}
