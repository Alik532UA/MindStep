// Realtime Database тримає рівно одне: присутність гравців у кімнаті —
// `/status/{roomId}/{playerId}` (див. `src/lib/services/presenceService.ts`).
//
// Доти тут стояло `.read: true` / `.write: true` у КОРЕНІ: будь-хто з публічним
// конфігом Firebase (а він за побудовою лежить у бандлі) міг прочитати всю базу
// одним запитом і стерти її одним записом. Тепер відкрита лише гілка
// присутності, решта дерева закрита типовим `false`.
//
// Авторизація тут навмисно не вимагається: `onDisconnect` реєструється до того,
// як завершиться анонімний вхід, і вимога `auth != null` зробила б показник
// «гравець вийшов» ненадійним саме в момент, коли він потрібен.
{
  "rules": {
    "status": {
      "$roomId": {
        ".read": true,
        "$playerId": {
          ".write": true,
          // Формат запису задає presenceService: { state, last_changed }.
          // Видалення (null) під `.validate` не потрапляє — це навмисно.
          ".validate": "newData.hasChildren(['state'])"
        }
      }
    }
  }
}
