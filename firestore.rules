rules_version = '2';

/*
 * Правила доступу до Firestore.
 *
 * ЄДИНА МЕЖА БЕЗПЕКИ. Публічний конфіг Firebase за побудовою лежить у бандлі,
 * тож адресу бази знає кожен, хто відкрив сайт. Усе, що робить із базою клієнт,
 * може зробити будь-хто тим самим SDK із консолі браузера — без нашого UI, без
 * нашої валідації, без нашої черги ходів. Отже єдине, що стоїть між відвідувачем
 * і чужими даними, — цей файл (CLOUD-DATABASE-v8 § 1).
 *
 * ПЕРЕВІРЯЮТЬСЯ ГЕЙТОМ, А НЕ ОЧИМА: `npm run check:rules` піднімає емулятор і
 * проганяє два набори випадків — «застосунок мусить це вміти» й «сторонній не
 * мусить цього могти». Правила «дозволити все» валять другий набір, «заборонити
 * все» — перший, тож зелений результат неможливий випадково.
 *
 * ЩО ЗМІНИЛОСЯ РЕВІЗІЄЮ 2026-08-18. Доти `rooms` та всі підколекції були
 * `allow read, write: if true` — БЕЗ АВТОРИЗАЦІЇ. Тобто будь-хто читав кожну
 * партію, перезаписував її стан і видаляв будь-яку кімнату (виклик видалення у
 * клієнті вже був). Причина дірки лежала не в правилі, а в МОДЕЛІ ДАНИХ: вся
 * партія була одним документом, який писали обидва гравці, тож власника не
 * існувало й звузити було нічого.
 *
 * Тепер у моделі кожен запис має власника:
 *
 *   rooms/{id}                     — опис кімнати; пише господар і учасники (свій рядок складу)
 *   rooms/{id}/moves/{seq}         — ОДИН ХІД: лише створити, лише від себе
 *   rooms/{id}/votes/{playerId}    — голос: лише сам гравець
 *   rooms/{id}/presence/{playerId} — присутність: лише сам гравець
 *
 * КЛЮЧОВИЙ ФАКТ, ЯКИЙ ЦЕ ДОЗВОЛЯЄ: `playerId` у цьому проєкті — це `auth.uid`
 * (`roomService.joinRoom`: `const playerId = currentUser.uid`). Тому кожен запис
 * можна звузити до автора, а не до «будь-хто авторизований».
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /** Чи є той, хто пише, учасником цієї кімнати. */
    function memberOf(room) {
      return signedIn() && request.auth.uid in room.data.players;
    }

    /** Чи є той, хто пише, господарем цієї кімнати. */
    function hostOf(room) {
      return signedIn() && room.data.hostId == request.auth.uid;
    }

    /*
     * --- ЗВУЖЕННЯ `update` ДО ПОЛІВ (CLOUD-DATABASE-v8 § 4.7) ---
     *
     * Доти тут стояло `allow update: if hostOf(resource) || memberOf(resource)`, і
     * читалося воно як «правити кімнату може господар або учасник». Означало ж
     * інше: БУДЬ-ЯКИЙ учасник кімнати міг записати в документ що завгодно —
     * поставити `hostId` собі, переписати `players` цілком, викинувши решту,
     * перевернути `isPrivate`, підмінити `settings` і перезаписати `match.seed`
     * посеред партії, тобто перероздати дошку всім. Правило назвало ЛЮДИНУ й не
     * назвало ПОЛЯ, а `resource` у ньому — документ ДО запису, тож про вміст
     * запису воно не сказало нічого.
     *
     * Те саме правило заразом забороняло ВХІД: той, хто заходить, ще не у складі,
     * тож `memberOf(resource)` для нього хибне. Зафіксовано гейтом: випадок
     * «ГІСТЬ заходить у кімнату» давав 403.
     */

    /** Які ключі верхнього рівня змінює цей запис. */
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /**
     * Чи зачепив запис ЛИШЕ свій рядок складу.
     *
     * `affectedKeys()` віддає ключі ВЕРХНЬОГО рівня, тож `players.abc.isReady`
     * показується просто як `players`. Тому потрібен ДРУГИЙ `diff` — уже на самій
     * мапі `players`, — і саме він дає перелік зачеплених `uid`. Порожній набір
     * (запис не торкався складу) `hasOnly` задовольняє.
     */
    function onlyMyPlayerRow() {
      return request.resource.data.players.diff(resource.data.players)
               .affectedKeys().hasOnly([request.auth.uid]);
    }

    /** Господарювання не змінюється тихою правкою поля. */
    function hostKept() {
      return request.resource.data.hostId == resource.data.hostId;
    }

    /**
     * Передача господарювання — законна рівно в одному сценарії: господар ІДЕ.
     *
     * `roomPlayerService.leaveRoom` призначає наступного, коли кімнату покидає
     * господар, тож заборонити зміну `hostId` цілком не можна. Але дозвіл звужений
     * до трьох умов разом: пише сам старий господар, він прибирає СЕБЕ зі складу,
     * і новий господар — із тих, хто лишився.
     */
    function hostHandover() {
      return resource.data.hostId == request.auth.uid
             && !(request.auth.uid in request.resource.data.players)
             && request.resource.data.hostId in request.resource.data.players;
    }

    /** Стан кімнати — з переліку, а не довільний рядок. */
    function statusValid() {
      return !('status' in request.resource.data)
             || request.resource.data.status in ['waiting', 'playing', 'finished'];
    }

    /**
     * Налаштування партії учасник міняє лише тоді, коли господар це дозволив.
     *
     * Прапорець `allowGuestSettings` існував і доти, але тримався виключно на UI:
     * той самий SDK із консолі писав `settings` попри нього.
     */
    function guestSettingsAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['settings'])
             || ('allowGuestSettings' in resource.data && resource.data.allowGuestSettings == true);
    }

    /**
     * Вхід нового учасника — ОКРЕМИЙ випадок, і його забувають саме тому, що він
     * не схожий на решту: той, хто заходить, ще не у складі.
     *
     * `maxPlayers` перевіряється лише якщо поле є: кімнати, створені старішою
     * збіркою, його не мають, і вимога зламала б вхід у них.
     */
    function joining() {
      return signedIn()
             && !(request.auth.uid in resource.data.players)
             && request.auth.uid in request.resource.data.players
             && onlyMyPlayerRow()
             && changedOnly(['players', 'lastActivity'])
             && hostKept()
             && resource.data.status == 'waiting'
             && (!('maxPlayers' in resource.data)
                 || request.resource.data.players.size() <= resource.data.maxPlayers);
    }

    /*
     * Профіль і нагороди гравця. ЧИТАЄ Й ПИШЕ ЛИШЕ ВЛАСНИК.
     *
     * Доти читання було `if true` — тобто будь-хто перелічував усіх користувачів
     * разом із їхньою статистикою одним запитом. Це не гіпотеза: живий зонд
     * `GET /documents/users` без жодного токена повертав документи.
     *
     * Дозвіл був зайвий: код звертається до `users/{uid}` і `rewards/{uid}`
     * ВИКЛЮЧНО через `uid` поточного користувача (`userProfileService`,
     * `rewardsState.syncWithCloud`). Публічні дані живуть окремо — у
     * `leaderboards`, і саме там читання відкрите навмисно.
     */
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /*
     * ПІДПИСКИ: дві половини одного факту, кожна зі своїм автором.
     *
     * `users/{uid}/following/{target}` — «на кого підписаний я»,
     * `users/{uid}/followers/{who}` — «хто підписаний на мене». Це РІЗНІ питання,
     * і обидва треба відповідати одним читанням: без дзеркала друге вимагало б
     * перебрати всіх користувачів, а перелічувати `users` заборонено.
     *
     * ДРУГ — ВЗАЄМНА ПІДПИСКА. Односторонню видно лише тому, хто підписався;
     * «друзі» — це відношення, у якому погодилися обидва, і перевірити його можна
     * лише подивившись з обох боків. Так само влаштовані сусідні `Slovko` і
     * `VetCrewGames`.
     *
     * ПРАВИЛО, А НЕ ЕКРАН, ТРИМАЄ ЗГОДУ: створити запис у чужих підписниках можна
     * лише поки той не закрив підписки на себе (`profiles/{uid}.privacy.follow`).
     * Клієнтський фільтр приховував би кнопку від того, хто дивиться екраном, і не
     * приховував би нічого від того, хто відкрив консоль.
     *
     * `!= false`, а не `== true`: профілю може ще не бути, і його відсутність
     * означає «можна» — інакше правило вимкнуло б підписки всім, хто не заходив у
     * налаштування.
     */
    match /users/{uid}/following/{target} {
      allow read: if signedIn();
      /*
       * Пише лише власник, і лише ПОЗНАЧКУ ЧАСУ: перелік полів тут не косметика
       * (§ 4.7). Без нього в документ підписки можна дописати що завгодно — а
       * читає його інша людина, і показує в себе на екрані.
       *
       * Видалити може ще й той, на кого підписані: це «прибери мене зі своїх
       * підписок», і без цього права відписати нав'язливого підписника було б нічим.
       */
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['at']);
      allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == target);
    }

    match /users/{uid}/followers/{who} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == who
                            && request.resource.data.keys().hasOnly(['at'])
                            && (
                                 !exists(/databases/$(database)/documents/profiles/$(uid))
                                 || get(/databases/$(database)/documents/profiles/$(uid)).data.get(['privacy', 'follow'], true) != false
                               );
      allow delete: if signedIn() && (request.auth.uid == who || request.auth.uid == uid);
    }

    /*
     * ПУБЛІЧНИЙ ПРОФІЛЬ: рівно те, що видно іншим, і нічого більше.
     *
     * `displayName`, аватар (`значок:колір`), країна двома літерами, перемикачі
     * приватності — і ХЕШ пошти замість самої пошти. Дозвіл читати документ
     * означає дозвіл читати всі його поля (правил рівня поля у Firestore не
     * існує), тож адреси тут немає й бути не може: пошук за точним збігом працює
     * так само по SHA-256, а витягти з нього адресу неможливо. Той самий висновок,
     * що в сусідньому `Slovko`.
     *
     * ПОШУК — ЛИШЕ СЕРЕД ЗГОДНИХ, і це тримає правило `list`. Запит без
     * `where('privacy.search', '==', true)` Firestore відкидає цілком: він не може
     * довести, що всі знайдені документи пройдуть правило. Тобто вимкнений пошук
     * означає відсутність у знахідках, а не фільтр на клієнті.
     *
     * `get` лишається відкритим для авторизованих: за `uid` профіль читає список
     * підписок і таблиця друзів, а приватного в ньому немає — саме тому пошта тут
     * хешем.
     */
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn()
                  && request.query.limit <= 20
                  && resource.data.privacy.search == true;
      /*
       * ВИДАЛЕННЯ — ОКРЕМИМ дозволом, і це не стиль.
       *
       * `allow write` покриває й видалення, а на видаленні `request.resource`
       * дорівнює null: перевірка `request.resource.data.keys()` у ньому кидає, і
       * правило відмовляє. Тобто одне правило «write із перевіркою форми»
       * зробило б профіль таким, що його неможливо прибрати — а прибирати його
       * треба, і саме при видаленні акаунта. Зловив це гейт, не читання коду.
       */
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'displayName', 'avatar', 'country', 'searchableEmailHash', 'privacy', 'updatedAt'
                      ])
                   && request.resource.data.displayName is string
                   && request.resource.data.displayName.size() <= 32
                   && request.resource.data.privacy.keys().hasOnly(['search', 'follow', 'board'])
                   && request.resource.data.privacy.search is bool
                   && request.resource.data.privacy.follow is bool
                   && request.resource.data.privacy.board is bool;
    }

    match /rewards/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /*
     * Таблиця рекордів. Ідентифікатор запису — `{uid}_{mode}_{size}`
     * (`leaderboardService`), тому власника видно з самого імені документа.
     * Читання відкрите: таблиця й існує, щоб її бачили всі.
     */
    match /leaderboards/{entryId} {
      allow get: if true;
      // Перелічувати можна — на цьому стоїть сама таблиця, — але порціями.
      // Без межі один запит вивантажує всю таблицю разом із іменами.
      allow list: if request.query.limit <= 100;
      /*
       * ЗГОДУ НА ПОКАЗ (`privacy.board`) правило тут НЕ перевіряє — і це рішення,
       * а не прогалина.
       *
       * Рядок таблиці може написати рівно один користувач: свій власний
       * (`entryId` починається з його `uid`). Тобто вимкнений перемикач може
       * порушити тільки СВІЙ КЛІЄНТ — стара вкладка, кеш, застаріла збірка, — а не
       * сторонній. Перевіряти це правилом означало б `get()` на кожен кінець
       * партії, тобто платне читання там, де загроза — власна стара вкладка
       * (CLOUD-DATABASE-v8 § 4.8: правило не читає інших документів).
       *
       * Тому вимикання працює інакше: клієнт стирає свій рядок і більше його не
       * пише. Видалення дозволене тим самим правилом нижче — і завжди, бо інакше
       * вийти з таблиці не змогла б саме та людина, яка цього захотіла.
       *
       * Порівняння: у сусідньому `VetCrewGames` та сама згода стоїть у правилі —
       * там RTDB, і читання чужого вузла з правила безкоштовне.
       */
      allow write: if signedIn() && entryId.split('_')[0] == request.auth.uid;
    }

    match /rooms/{roomId} {
      /*
       * Читають авторизовані. Перелічувати кімнати теж можна — на цьому стоїть
       * лобі, — але лише з обмеженням розміру: без нього один запит витягує всі
       * кімнати з усім їхнім вмістом (CLOUD-DATABASE-v8 § 7.1).
       */
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;

      /** Створити кімнату можна, лише назвавши господарем СЕБЕ. */
      allow create: if signedIn()
                    && request.resource.data.hostId == request.auth.uid;

      /*
       * ПРАВКА КІМНАТИ — три різні дозволи, а не один.
       *
       * Спільні умови для всіх трьох: стан із переліку, і `hostId` або незмінний,
       * або переданий за правилами `hostHandover()`.
       *
       * 1. ГОСПОДАР міняє перелічені поля кімнати. `isPrivate`, `maxPlayers` і
       *    `createdAt` до переліку НЕ входять: вони задаються при створенні й
       *    після нього не міняються ніким — доти публічність кімнати перевертав
       *    будь-який учасник.
       * 2. УЧАСНИК міняє свій рядок складу, позначку активності й стан кімнати
       *    (`returnToLobby` і `leaveRoom` кличе не господар). Налаштування —
       *    лише якщо господар дозволив гостям. `match` для учасника закритий:
       *    доти він міг перекотити `seed` посеред партії.
       * 3. ГІСТЬ, який заходить, додає рівно свій рядок — див. `joining()`.
       */
      allow update: if signedIn() && statusValid() && (hostKept() || hostHandover()) && (
        (hostOf(resource)
           && changedOnly(['players', 'lastActivity', 'status', 'settings', 'settingsLocked',
                           'allowGuestSettings', 'name', 'match', 'hostId']))
        || (memberOf(resource)
           && onlyMyPlayerRow()
           && guestSettingsAllowed()
           && changedOnly(['players', 'lastActivity', 'status', 'settings', 'hostId']))
        || joining()
      );

      /*
       * ЗНЕСТИ кімнату може лише господар. Доти це міг будь-хто без
       * авторизації — і в клієнті вже лежав виклик видалення, тобто готовий
       * примітив «видалити всі кімнати» одним циклом.
       */
      allow delete: if hostOf(resource);

      /*
       * ЖУРНАЛ ХОДІВ — головне правило цього файлу.
       *
       * `create` і тільки `create`: жодного `update`, жодного `delete` окрім
       * господаря. Дві властивості за одну умову: журнал не переписати, і хід не
       * підписати чужим імʼям. Звідси ідемпотентність без сервера — повторний
       * запис того самого номера відкидає БАЗА, а не клієнт, тож двоє гравців,
       * які одночасно займають номер, розв'язуються самі.
       */
      /*
       * ЖУРНАЛ ХОДІВ — головне правило цього файлу, і тепер воно ЛОКАЛЬНЕ.
       *
       * Ключ документа — `{segment}-{seq}`, і це знімає три речі одразу
       * (CLOUD-DATABASE-v8 § 8.7). Доти «нова партія в тій самій кімнаті» означала
       * СТЕРТИ журнал, і переклад цієї операції у Firestore давав три дефекти:
       *
       *  1. читання всього журналу заради того, щоб його видалити — платимо за
       *     кожен хід другий раз;
       *  2. межа батча 500: партія, довша за 499 ходів, не перезапускалася взагалі;
       *  3. `get()` на кімнату в правилі `delete` — по одному зверненню на кожен
       *     видалений хід при межі 20 звернень на батч (§ 4.8). Тобто перезапуск
       *     після довгої партії впирався у правила, а не в код.
       *
       * Тепер відрізок партії — НОВИЙ СЕГМЕНТ: опис кімнати називає номер, ключ
       * ходу його несе, а перепрогін бере лише ходи поточного сегмента. Видалення
       * не потрібне нікому, тож його немає — і разом із ним немає ні батча, ні
       * `get()`. Журнал став тим, чим і мусив бути: append-only.
       *
       * `hasOnly` поруч із `hasAll`: без нього хід приймав довільні зайві поля
       * до мегабайта в кожному (§ 4.6).
       */
      match /moves/{moveId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.keys().hasAll(['segment', 'seq', 'by', 'direction', 'distance'])
                      && request.resource.data.keys().hasOnly(['segment', 'seq', 'by', 'direction', 'distance', 'at'])
                      && request.resource.data.segment is int
                      && request.resource.data.seq is int
                      && request.resource.data.distance is int
                      && request.resource.data.direction is string
                      && request.resource.data.direction.size() <= 16;
        // Ні переписати, ні стерти — НІКОМУ, включно з господарем. Подія, яку
        // можна видалити, не є подією.
        allow update, delete: if false;
      }

      /*
       * Голос гравця. Документ названий його ідентифікатором, тож власника видно
       * з імені — і правило стає одним рядком.
       *
       * Доти голоси лежали полями в `gameState`, і щоб проголосувати, доводилося
       * писати весь документ партії. Тобто голосування було ще одним шляхом
       * перезапису чужого стану.
       */
      /*
       * Голос гравця — і КІНЕЦЬ ПАРТІЇ, який тепер лежить тут само.
       *
       * Доти кінець партії писався в `votes/__match`, а це правило звіряє
       * ідентифікатор документа з `auth.uid`: `'__match'` не дорівнює жодному uid,
       * тож запис відкидався ЗАВЖДИ. Кінець партії не доїжджав до суперника
       * ніколи, а виклик ішов через `void patchState(...)`, тож відмова гинула без
       * сліду. Колекція мала випадок у гейті, правило написане правильно — не
       * збігався лише ідентифікатор документа, який код підставляв в обхід власної
       * ж моделі власності (CLOUD-DATABASE-v8 § 3.5).
       *
       * Тепер `over` лежить у документі ТОГО, ХТО оголосив: власник у ключі, як і
       * все інше тут, і правило лишається одним рядком.
       */
      match /votes/{playerId} {
        allow read: if signedIn();
        allow write: if signedIn() && playerId == request.auth.uid;
      }

      /** Чат кімнати: автор повідомлення — той, хто пише. Правити не можна. */
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      /** Решта підколекцій кімнати — заборонено. */
      match /{other=**} {
        allow read, write: if false;
      }
    }

    /*
     * Відгуки: `feedback/{type}/entries/{id}`. Форму відкриває будь-хто,
     * зокрема неавторизований відвідувач, тому створення відкрите. Читання
     * закрите — застосунок відгуків не читає, їх дивляться з консолі.
     */
    match /feedback/{type}/entries/{entryId} {
      /*
       * ТОЧКА, ОБСЯГ ЯКОЇ ЗАДАЄ СТОРОННІЙ (CLOUD-DATABASE-v8 § 12.1).
       *
       * Доти тут стояло `allow create: if true` без жодних меж, і це означало не
       * «зручно гостеві», а «будь-хто в інтернеті дописує документи в мою базу зі
       * швидкістю мережі». UI для цього не потрібен: адреса бази публічна за
       * побудовою.
       *
       * Створення лишається відкритим для НЕАВТОРИЗОВАНОГО — форму справді
       * відкриває гість, і вимога входу відрізала б саме тих, чиї відгуки
       * найцінніші. Натомість стоять три інші межі: перелік ключів, перелік типів
       * і довжина кожного текстового поля.
       */
      allow create: if type in ['bug', 'improvement', 'other', 'reward_suggestion']
                    && request.resource.data.keys().hasAll(['type'])
                    && request.resource.data.keys().hasOnly(
                         ['type', 'page', 'text', 'actualResult', 'expectedResult',
                          'context', 'createdAt', 'status', 'id'])
                    // Тип у полі мусить збігатися з типом у ШЛЯХУ: інакше відгук
                    // ляже в чужу теку й у консолі його не знайде ніхто.
                    && request.resource.data.type == type
                    && (!('text' in request.resource.data)
                        || request.resource.data.text.size() <= 4000)
                    && (!('actualResult' in request.resource.data)
                        || request.resource.data.actualResult.size() <= 4000)
                    && (!('expectedResult' in request.resource.data)
                        || request.resource.data.expectedResult.size() <= 4000);
      allow read, update, delete: if false;
    }

    /*
     * Лічильники: `general/stats`. Читає будь-хто, пише лише авторизований — і
     * лише ті поля, які застосунок справді веде. Доти тут стояло `if true`, тож
     * довільний ключ у спільний документ дописував будь-хто.
     */
    match /general/{docId} {
      allow read: if true;
      /*
       * Лічильники лише ЗРОСТАЮТЬ, і це не педантизм.
       *
       * Перелік ключів стояв і доти, тож довільне поле дописати не можна було. Але
       * значення не перевірялося ніяк: будь-хто авторизований обнуляв спільні
       * лічильники або ставив `lastRoomCreatedAt` у майбутнє — а від цієї позначки
       * лобі вирішує, чи є новіші кімнати.
       */
      allow write: if signedIn()
                   && request.resource.data.keys().hasOnly(['lastRoomCreatedAt', 'totalRooms', 'totalGames'])
                   // `resource == null` — це СТВОРЕННЯ. Без цієї перевірки звернення
                   // до `resource.data` на першому в житті записі кидає, і правило
                   // відмовляє: документ `general/stats` неможливо було б завести.
                   && (resource == null || (
                        (!('lastRoomCreatedAt' in resource.data)
                          || request.resource.data.lastRoomCreatedAt >= resource.data.lastRoomCreatedAt)
                        && (!('totalRooms' in resource.data)
                          || request.resource.data.totalRooms >= resource.data.totalRooms)
                        && (!('totalGames' in resource.data)
                          || request.resource.data.totalGames >= resource.data.totalGames)
                      ));
    }

    /*
     * Усе інше — заборонено. Саме цей блок і закриває головну дірку: без нього
     * чужа колекція заводиться одним запитом із DevTools.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
