{
  "name": "mindstep",
  "description": "A multi-game platform with 'Survive', 'Arena', and 'Maze' modes.",
  "private": true,
  "version": "0.5.934",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/robust-test.js",
    "test:online": "firebase emulators:exec \"playwright test tests/e2e/online\"",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=test-reports/test-results.json",
    "dev": "vite dev",
    "emulators": "firebase emulators:start",
    "build": "node scripts/generate-version.js && node scripts/generate-sitemap.mjs && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:build": "node scripts/check-build.mjs",
    "check:rules": "firebase emulators:exec --project demo-mindstep --only firestore,database,auth \"node scripts/check-rules.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:knip": "knip",
    "lint:all": "npm run lint && npm run lint:knip",
    "diagnose": "node scripts/diagnose.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^24.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-svelte": "^3.23.0",
    "firebase-tools": "^15.28.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^5.62.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-svelte": "^0.562.0",
    "pretty-bytes": "^7.1.1",
    "svelte-i18n": "^4.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  }
}
