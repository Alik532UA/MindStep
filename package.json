{
  "name": "mindstep",
  "description": "A multi-game platform with 'Survive', 'Arena', and 'Maze' modes.",
  "private": true,
  "version": "0.5.816",
  "type": "module",
  "scripts": {
    "test": "node scripts/robust-test.js",
    "test:online": "firebase emulators:exec \"playwright test tests/e2e/online\"",
    "test:report": "vitest run --reporter=json --outputFile=test-reports/test-results.json",
    "dev": "vite dev",
    "emulators": "firebase emulators:start",
    "build": "node scripts/generate-version.js && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:knip": "knip",
    "lint:all": "npm run lint && npm run lint:knip",
    "diagnose": "node scripts/diagnose.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neoconfetti/svelte": "^2.0.0",
    "@playwright/test": "^1.55.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.17.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^24.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "firebase-tools": "^15.8.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^5.62.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "svelte": "^5.20.2",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "firebase": "^12.6.0",
    "lucide-svelte": "^0.562.0",
    "pretty-bytes": "^7.1.0",
    "svelte-i18n": "^4.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
